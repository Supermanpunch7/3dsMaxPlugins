#include <windows.h>
// Dedicated selector resource; do not alter the research builds' dialog.
202 DIALOGEX 0, 0, 186, 54
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "Chamfer 1", 1001, "Button", WS_CHILD | WS_VISIBLE | BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 8, 55, 18
    CONTROL "Chamfer 2", 1002, "Button", WS_CHILD | WS_VISIBLE | BS_AUTORADIOBUTTON | WS_TABSTOP, 96, 8, 55, 18
    CONTROL "On", 1011, "Button", WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 65, 8, 28, 18
    CONTROL "On", 1012, "Button", WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX | WS_TABSTOP, 153, 8, 28, 18
    CONTROL "", 1014, "ColorSwatch", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 33, 20, 12
    CONTROL "Display Hard Edges", 1013, "Button", WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX | WS_TABSTOP, 34, 31, 142, 16
END